<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000" android:padding="16dp">
    <EditText android:id="@+id/editTextInput" android:layout_width="0dp" android:layout_height="180dp"
        android:background="#1A1A1A" android:gravity="top|start" android:hint="Enter text..."
        android:inputType="textMultiLine" android:padding="12dp" android:textColor="#FFFFFF" android:textColorHint="#888888"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"/>
    <Spinner android:id="@+id/spinnerVoice" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:background="#1A1A1A" android:padding="8dp"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/editTextInput"/>
    <ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:max="100" android:progress="0" android:progressTint="#FF0000"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/spinnerVoice"/>
    <Button android:id="@+id/btnGenerate" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:backgroundTint="#FF0000" android:text="Generate Speech" android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/progressBar"/>
    <Button android:id="@+id/btnSave" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:backgroundTint="#CC0000" android:text="Save to Storage" android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/btnGenerate"/>
    <Button android:id="@+id/btnPlayPause" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:backgroundTint="#990000" android:text="Play" android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/btnSave"/>
</androidx.constraintlayout.widget.ConstraintLayout>