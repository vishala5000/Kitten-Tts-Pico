  },
  "int4": {
   "weights": "int4, symmetric, blocks of 128 along the input axis with one fp16 scale per block (DequantizeLinear block_size); ~1% most sensitive weights int8; small float parameters fp16",
   "activations": "float32",
   "method": "quantization-aware distillation from the fp32 model",
   "requires": "onnxruntime>=1.20 (ONNX opset 21)"
  }
